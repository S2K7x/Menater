# =============================================================================
# MENATER — Docker stack configuration
# =============================================================================
#     cp .env.example .env
#     docker compose up -d --build
#
# THIS FILE IS A TEMPLATE: it holds no real secret and is versioned.
# `.env` does hold them, and stays out of the repository.
# =============================================================================

# --- Database (required) ------------------------------------------------------
# Two DISTINCT passwords, deliberately: the schema owner and the application
# role. The application cannot rewrite its own audit evidence — see the
# GRANT/REVOKE statements in sql/05-audit-log.sql.
#
# MENATER_DB_PASSWORD is also what the console's engine connects with. The rest
# of the coordinates (host, port, database, user) are set by docker-compose.
POSTGRES_USER=menater
POSTGRES_DB=menater
POSTGRES_PASSWORD=change-me-schema-owner
MENATER_DB_PASSWORD=change-me-application-role

# --- Console port -------------------------------------------------------------
MENATER_PORT=4400

# --- Model and notifications --------------------------------------------------
# Without a key the pipeline falls back to its fail-safe verdict: `needs_human`,
# confidence 0, escalate. An alert is never lost; it goes to a human. Nothing is
# triaged either, which is why the setup checklist calls this one out.
#
# It can also be pasted in Settings -> Credentials, and takes effect with no
# restart.
OPENROUTER_API_KEY=
SLACK_BOT_TOKEN=

# --- Enrichment ---------------------------------------------------------------
# Optional. A missing source is shown as "unavailable", never filled in — and
# the model has to name it in its reasoning (guardrail G10).
SHODAN_API_KEY=
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=

# --- Manual lookup (Lookup tab) -----------------------------------------------
# Optional, and used ONLY when a human types an email address into the Lookup
# tab: the pipeline never queries it. An alert carries observables an attacker
# chose, and an address in a log is not evidence its owner did anything — so
# checking it automatically would spend a per-key quota on someone else's
# exposure.
#
# Everything else in that tab works without this: VirusTotal, AbuseIPDB and
# Shodan reuse the enrichment keys above, Shodan's InternetDB and the
# Pwned Passwords check need no key at all.
HIBP_API_KEY=

# --- Code analysis ------------------------------------------------------------
# At least one, or the Code tab shows "key missing" for every engine.
# They can also be typed in Settings -> Code analysis, hot.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Folder to analyse, mounted read-only in the container.
MENATER_SCAN_ROOT=./


# --- Profile `tunnel` — exposure to the Internet ------------------------------
#     docker compose --profile tunnel up -d
# ONLY ENABLE THIS AFTER setting an ingestion secret in Settings -> Ingestion.
# Without one the entry point stays closed — but the tunnel would already be
# open.
CLOUDFLARE_TUNNEL_TOKEN=

TZ=Europe/Paris
