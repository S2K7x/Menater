# MENATER — configuration du serveur d'API.
#
# The console reads the pipeline from the engine's own run journal in Postgres.
# With no database configured it starts in DEMONSTRATION MODE and says so.
#
# Les anciens noms SOC_* restent acceptes en repli.


# Port de l'API de la console (le proxy Vite pointe dessus).
MENATER_API_PORT=4400

# --- VulnPipe -----------------------------------------------------------------
#
# L'onglet Code de la console parle a VulnPipe, qui tourne dans son propre
# service (depot VulnPipe/, `npm run serve`). La console relaie les appels sous
# /api/vulnpipe/* : le navigateur ne voit qu'une seule origine.
#
# Laisser vide utilise http://localhost:4319. VULNPIPE_API_URL prime si les deux
# sont definis.
VULNPIPE_API_PORT=4319
# VULNPIPE_API_URL=http://localhost:4319
