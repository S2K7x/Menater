{
  "name": "vulnpipe",
  "version": "1.0.0",
  "description": "Moteur d'analyse de vulnerabilites : indexation tree-sitter, detecteurs LLM, arbitrage. L'interface vit dans la console MENATER (dashboard/).",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "probe": "node scripts/probe-treesitter.cjs && node scripts/probe-shapes.cjs",
    "index": "node --experimental-strip-types src/indexer/cli.ts",
    "typecheck": "tsc --noEmit",
    "mcp": "node --experimental-strip-types src/mcp-server/server.ts",
    "bench": "node --experimental-strip-types scripts/bench-idor.ts",
    "measure": "node --experimental-strip-types scripts/measure-pipeline.ts",
    "report": "node --experimental-strip-types scripts/report-demo.ts",
    "e2e": "node --experimental-strip-types scripts/e2e-demo.ts",
    "qa": "node --expose-gc --experimental-strip-types scripts/qa-stress.ts",
    "serve": "node --experimental-strip-types src/orchestration/server.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "tree-sitter": "^0.21.1",
    "tree-sitter-typescript": "^0.23.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
